# Copy to .env and fill in. .env is gitignored - never commit it.

# ---- Vertex AI ----
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Auth comes from Application Default Credentials, not a key in this file:
#   gcloud auth application-default login
#   gcloud config set project <your-project-id>
# If you use a service account instead, point at its key file:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sa-key.json

# ---- Run mode ----
# auto  = cache when present, call Vertex on a miss (default while building)
# live  = always call Vertex, still writes cache (use to build the cache)
# replay= cache only, raise on a miss (USE THIS FOR THE LIVE DEMO)
AC_LLM_MODE=auto
